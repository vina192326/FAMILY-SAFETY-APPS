# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/familysafety
DATABASE_USER=familysafety
DATABASE_PASSWORD=CHANGE_ME

# API
PORT=8080
PUBLIC_BASE_URL=https://api.example.invalid
TOKEN_PEPPER=CHANGE_TO_A_LONG_RANDOM_SECRET

# Razorpay: set real values in deployment secrets, never commit them
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Owner authentication: provision via secure secret manager

# Owner authentication
# Generate BCrypt hashes for newly chosen private passwords; comma-separated hashes only.
# Do NOT put plaintext passwords here or in the APK/source repository.
OWNER_PASSWORD_HASHES= # comma-separated BCrypt hashes; initial hashes are seeded by V003 migration
# Optional: if a User ID is entered, it must match this configured value.
# Leave blank to disable User ID matching; password-only login remains enabled.
OWNER_USER_ID=
